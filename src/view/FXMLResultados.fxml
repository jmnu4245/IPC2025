                  <TableColumn fx:id="colAciertos" editable="false" prefWidth="83.0" sortable="false" text="Aciertos" />
                  <TableColumn fx:id="colFallos" editable="false" prefWidth="64.0" sortable="false" text="Fallos" />
              </columns>
